#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

# Пути переопределяются из окружения: на машине разработчика нет ни procd, ни
# nft, ни демона, и без этого init-скрипт нельзя было бы проверить тестами.
BIN="${TGWS_BIN:-/usr/bin/tgws}"
LIBDIR="${TGWS_LIBDIR:-/usr/libexec/tgws}"
NFT="${TGWS_NFT:-nft}"
RUN="${TGWS_RUN:-/var/run}"
STATS="$RUN/tgws.json"
RULESET="$RUN/tgws.nft"

# Отметка исходящих сокетов демона. luci-app-trusttunnel возвращает пакеты с
# этой отметкой без маркировки в туннель, поэтому значение обязано совпадать с
# константой в его routing.
MARK=0x7467

# Читает настройки в ENABLED, PORT, DC_IP, LAN. Вызывается и из start_service,
# и из service_started: переменные первой не переживают гарантированно, а
# повторное чтение дешёвое.
read_settings() {
	config_load tgws
	config_get_bool ENABLED main enabled 0
	config_get PORT main port 5454
	config_get DC_IP main dc_ip "2:149.154.167.220,4:149.154.167.220"
	config_get LAN main lan_devices ""
	config_get FALLBACK_MARK main fallback_mark ""
	config_get SUBNETS_URL main subnets_url ""
	config_get IP_DC main ip_dc ""
	case "$PORT" in
		''|*[!0-9]*) logger -t tgws "warning: bad port '$PORT', using 5454"; PORT=5454 ;;
		*)
			# Ведущие нули срезаются: 06000 — это порт 6000, а не
			# восьмеричное число. Слишком длинное число ломает `test` и
			# тоже даёт значение по умолчанию.
			PORT=$(printf '%s' "$PORT" | sed 's/^0*//')
			{ [ -n "$PORT" ] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ]; } || PORT=5454
			;;
	esac
	if [ -z "$LAN" ]; then
		LAN=$(uci -q get network.lan.device 2>/dev/null) || LAN=""
	fi
	[ -n "$LAN" ] || LAN=br-lan
}

# Демон готов, когда есть его файл счётчиков: он пишет его сразу после bind и
# удаляет при остановке до закрытия порта. Проверка по netstat принимала бы
# за демона любой процесс на этом порту: демон упал бы на bind, таблица
# загрузилась бы, и Telegram всей сети уходил бы в чужую службу.
daemon_ready() { [ -s "$STATS" ]; }

# Таблица nft грузится только после готовности демона: пока он не слушает,
# перенаправленные соединения получили бы отказ, и Telegram на всех
# устройствах сети перестал бы работать. Десять секунд, потому что при
# перезапуске новый экземпляр может ждать, пока старый освободит порт
# (procd возвращается раньше, чем тот завершится).
wait_listening() {
	_i=0
	while [ "$_i" -lt 10 ]; do
		daemon_ready && return 0
		sleep 1
		_i=$((_i + 1))
	done
	return 1
}

load_nft() {
	# Через файл, а не конвейером: у конвейера код возврата — последней
	# команды, и сбой генератора выглядел бы как успешная загрузка пустого
	# ruleset.
	if ! "$LIBDIR/gen-nft" "$1" "$2" > "$RULESET"; then
		logger -t tgws "error: cannot generate the ruleset; Telegram traffic is left alone"
		return 1
	fi
	if ! "$NFT" -f "$RULESET"; then
		logger -t tgws "error: nft rejected the ruleset; Telegram traffic is left alone"
		return 1
	fi
	logger -t tgws "intercepting Telegram on :$1"
}

# Снимает таблицу перехвата. Нужна не только на остановке: когда start не
# открыл ни одного экземпляра, procd убивает работающий, а загруженная таблица
# осталась бы и перенаправляла Telegram всей сети в закрытый порт.
drop_nft() {
	"$NFT" delete table inet tgws 2>/dev/null || true
	rm -f "$RULESET"
}

start_service() {
	read_settings
	[ "$ENABLED" = "1" ] || {
		drop_nft
		logger -t tgws "disabled in configuration, not starting; to enable: uci set tgws.main.enabled=1; uci commit tgws; /etc/init.d/tgws restart"
		return 0
	}
	[ -x "$BIN" ] || {
		drop_nft
		logger -t tgws "error: $BIN not found; run install.sh"
		return 1
	}
	# LuCI удаляет опцию, когда поле очищено, а read_settings подставляет
	# значение по умолчанию, поэтому «WebSocket не нужен вовсе» выражается
	# явным словом none.
	[ "$DC_IP" = "none" ] && DC_IP=""
	# Значение идёт в аргумент демона, но проверяется всё равно: опечатка
	# должна остановить запуск с понятной причиной, а не оставить демон
	# с нерабочей таблицей целей.
	case "$DC_IP" in
		*[!0-9.:,\ ]*)
			drop_nft
			logger -t tgws "error: dc_ip has unsupported characters: '$DC_IP'"
			return 1
			;;
	esac
	# Допустимые символы ещё не допустимый смысл (DC 7 не существует). Разбор
	# целей делает сам демон, чтобы правило было одно: иначе он завершался бы
	# при старте, а procd перезапускал его каждые 5 секунд.
	# Метка для соединений, которые нельзя провести через WebSocket (веб,
	# DC без цели WebSocket): метка туннеля TrustTunnel (0x9527) отправляет их
	# по его таблице маршрутов. Пусто или 0 — не используется.
	case "$FALLBACK_MARK" in
		''|0|0x0|0X0) FALLBACK_MARK="" ;;
		*[!0-9a-fA-FxX]*)
			drop_nft
			logger -t tgws "error: fallback_mark has unsupported characters: '$FALLBACK_MARK'"
			return 1
			;;
	esac
	# Ручная привязка адресов к DC (IP:DC через запятую): Android в прямом
	# соединении не пишет настоящий индекс DC, и для нового адреса его можно
	# привязать вручную.
	case "$IP_DC" in
		*[!0-9.:,\ ]*)
			drop_nft
			logger -t tgws "error: ip_dc has unsupported characters: '$IP_DC'"
			return 1
			;;
	esac
	# Одни и те же значения проверяет сам демон (-check) и затем получает при
	# запуске: правило допустимости одно, а недопустимое значение иначе
	# завершало бы демон при старте, и procd перезапускал бы его каждые 5 секунд.
	set -- -dc-ip "$DC_IP"
	[ -n "$FALLBACK_MARK" ] && set -- "$@" -fallback-mark "$FALLBACK_MARK"
	[ -n "$IP_DC" ] && set -- "$@" -ip-dc "$IP_DC"
	if ! "$BIN" "$@" -check >/dev/null 2>&1; then
		drop_nft
		logger -t tgws "error: the daemon rejects dc_ip '$DC_IP', ip_dc '$IP_DC' or fallback_mark '$FALLBACK_MARK'; expected pairs like 2:149.154.167.220 (or none), pairs like 149.154.167.35:2 and a number like 0x9527"
		return 1
	fi
	# Файл прошлого экземпляра иначе сошёл бы за готовность нового.
	rm -f "$STATS"

	set -- "$BIN" -listen ":$PORT" -dc-ip "$DC_IP" -mark "$MARK" -stats "$STATS"
	[ -n "$FALLBACK_MARK" ] && set -- "$@" -fallback-mark "$FALLBACK_MARK"
	[ -n "$IP_DC" ] && set -- "$@" -ip-dc "$IP_DC"
	procd_open_instance tgws
	procd_set_param command "$@"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Вызывается rc.common после start_service. Здесь, а не в start_service,
# потому что процесс инстанса procd запускает уже после возврата из
# start_service: ждать в нём порт бессмысленно.
service_started() {
	read_settings
	[ "$ENABLED" = "1" ] || return 0
	[ -x "$BIN" ] || return 0
	if ! wait_listening "$PORT"; then
		logger -t tgws "error: the daemon is not listening on :$PORT; Telegram traffic is left alone"
		return 0
	fi
	load_nft "$PORT" "$LAN"
}

# Таблица снимается ПЕРВОЙ, до остановки демона: иначе в промежутке
# перенаправленные соединения упирались бы в закрытый порт.
stop_service() {
	drop_nft
	# Демон удаляет файл и сам, но убитый сигналом KILL не успеет; а LuCI не
	# должен показывать счётчики давно умершего процесса.
	rm -f "$STATS"
	return 0
}

EXTRA_COMMANDS="update_subnets"
EXTRA_HELP="	update_subnets	Refresh the Telegram subnet list and reload the rules"

# Обновляет список подсетей Telegram и, если он изменился и демон работает,
# перезагружает правила. Таблицу при неработающем демоне не загружаем:
# перенаправлять в закрытый порт нельзя.
update_subnets() {
	read_settings
	if ! _res=$(TGWS_SUBNETS_URL="$SUBNETS_URL" "$LIBDIR/update-subnets" 2>&1); then
		logger -t tgws "subnet list update failed: $_res"
		return 1
	fi
	case "$_res" in
		updated*)
			logger -t tgws "subnet list $_res"
			if [ "$ENABLED" = "1" ] && daemon_ready; then
				load_nft "$PORT" "$LAN"
			fi
			;;
	esac
	return 0
}

service_triggers() {
	procd_add_reload_trigger tgws
}

reload_service() {
	restart
}
