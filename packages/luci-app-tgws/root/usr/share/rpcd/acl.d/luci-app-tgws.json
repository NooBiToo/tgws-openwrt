{
	"luci-app-tgws": {
		"description": "Grant access to the Telegram WebSocket proxy settings and diagnostics",
		"read": {
			"ubus": {
				"luci.tgws": [ "status", "log", "versions", "probe", "diagnose" ]
			},
			"uci": [ "tgws" ]
		},
		"write": {
			"ubus": {
				"luci.tgws": [ "service" ]
			},
			"uci": [ "tgws" ]
		}
	}
}
